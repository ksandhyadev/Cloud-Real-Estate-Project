# Cloud-Based Real Estate Analysis - Environment Configuration
# Copy this file to .env and provide your secret keys

PROJECT_NAME="Cloud-Based Real Estate Analysis"
SECRET_KEY="your-super-secret-jwt-key-replace-in-production"
ENVIRONMENT="development"

# Database Configuration (Defaults to SQLite for local development, PostgreSQL for Docker/Production)
DATABASE_URL="sqlite:///./real_estate.db"
# Example PostgreSQL URL: postgresql://postgres:postgres@localhost:5432/realestate_db

# External Location & POI API (Geoapify)
# Sign up at https://www.geoapify.com/ to obtain a free API key (3000 requests/day free tier)
# If left blank, the application will use the built-in resilient academic benchmark spatial dataset
GEOAPIFY_API_KEY=""

# Server Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
